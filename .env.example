# Copiez ce fichier en ".env" et renseignez vos propres valeurs.
# Ne jamais committer le fichier ".env" réel dans un dépôt de code.

# --- Django ---
SECRET_KEY=change-moi-avec-une-cle-secrete-longue-et-aleatoire
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# --- Base de données MySQL (WampServer) ---
DB_NAME=stockmanager_db
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# --- Entreprise ---
COMPANY_NAME=Kamsar Street
COMPANY_CURRENCY=GNF

# ============================================================
# Variables SUPPLÉMENTAIRES pour un hébergement en ligne
# (Render, Railway...) — à ignorer pour un usage local WampServer.
# ============================================================

# Fournie automatiquement par la plupart des hébergeurs quand vous
# ajoutez une base de données à votre projet (Postgres ou MySQL selon
# l'offre). Si elle est définie, elle remplace DB_NAME/DB_USER/etc.
# Format : postgres://utilisateur:motdepasse@hote:5432/nom_base
# DATABASE_URL=

# Domaine HTTPS complet de votre application une fois déployée
# (nécessaire pour que les formulaires fonctionnent en production).
# CSRF_TRUSTED_ORIGINS=https://votre-app.onrender.com

# Mettez DEBUG=False en production (jamais True sur un site public).

# --- Super administrateur de production (Render / hébergement) ---
# Ces valeurs doivent être définies dans les variables d'environnement du service de production.
# Ne JAMAIS enregistrer la vraie valeur dans le dépôt.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@votre-domaine.com
ADMIN_PASSWORD=change-me-strong-password

